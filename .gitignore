# --- manuscript source ----------------------------------------------------
# The paper itself is kept outside version control; this repository holds the
# dataset and the analysis pipeline only.
manuscript/manuscript.tex
manuscript/supplementary.tex
manuscript/references.bib

# The per-journal submission folders are rebuildable bundles: generated copies of
# the sources above plus the built PDFs. Regenerate the lot with
# `make submissions` from manuscript/ (see scripts/build_submissions.py).
# Hand-written text in them (UPLOAD.txt, Submission_Info.txt, cover_letter.tex,
# Highlights.txt, the questionnaires) is NOT ignored and is tracked below.
manuscript/submissions/*/upload/
manuscript/submissions/*/manuscript.pdf
manuscript/submissions/*/supplementary.pdf
manuscript/submissions/*/supplementary.tex
manuscript/submissions/*/cover_letter.pdf
manuscript/submissions/*/Turnitin/

# --- third-party material -------------------------------------------------
# Published papers are cited in references.bib with DOIs; the publisher PDFs
# are not ours to redistribute.
draft/

# --- dependencies ---------------------------------------------------------
manuscript/scripts/figures_d3/node_modules/

# --- generated outputs ----------------------------------------------------
# Everything below is rebuilt by `make`, `make figures` or `make docx`.
manuscript/manuscript.pdf
manuscript/supplementary.pdf
manuscript/figures/*.pdf
manuscript/figures/svg/
manuscript/figures/data/
manuscript/docx/
manuscript/tables/*.tex
manuscript/data/clean_data.csv
manuscript/data/clean_data.pkl
manuscript/data/risk_loading.csv
manuscript/exploration/outputs/

# --- LaTeX build artefacts ------------------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.spl
*.toc
*.synctex.gz

# --- python / macOS -------------------------------------------------------
__pycache__/
*.pyc
.DS_Store
._*

# --- scratch inbox --------------------------------------------------------
# Working drop for incoming lab files and review memos. The data that matters
# is copied into manuscript/data/; the memo in here relates to a different
# manuscript and is not ours to redistribute.
newcorrectiondata/
